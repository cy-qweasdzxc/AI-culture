# Copy to .env at repository root; never commit private values.
# Local backend commands run from backend/. Compose overrides DATABASE_URL.
APP_ENV=development
DATABASE_URL=sqlite:///./data/city_story.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Production refuses placeholders/short secrets. Generate two distinct secrets.
SESSION_SECRET=development-session-secret-change-before-deployment
ADMIN_JWT_SECRET=development-admin-secret-change-before-deployment
ADMIN_USERNAME=admin
# Empty disables ALL admin endpoints. Also set a private ADMIN_JWT_SECRET.
# Production requires at least 12 password chars.
ADMIN_PASSWORD=
# Compose requires a database password; hexadecimal avoids URL escaping.
DB_PASSWORD=

# deepseek / qwen / ollama / mock. Missing remote key is visibly marked Mock.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
AI_TIMEOUT_SECONDS=30
# DeepSeek compatible base: https://api.deepseek.com/v1
# Qwen compatible base: https://dashscope.aliyuncs.com/compatible-mode/v1
# Ollama base: http://127.0.0.1:11434 (container requires its own reachable host)
# Select an available model explicitly; no untested model name is forced.

# Embeddings are independent of the chat model.
# none / openai-compatible / qwen / ollama
EMBEDDING_PROVIDER=none
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1024
# none publishes keyword chunks; configured providers require matching dimension.
