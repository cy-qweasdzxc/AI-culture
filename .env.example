# ============================================================
# 城迹入戏 · 环境变量示例
# 使用：cp .env.example .env 后按需修改。
# 红线：.env 已被 .gitignore 排除，禁止提交任何真实密钥！
# ============================================================

# 运行环境：development / production
APP_ENV=development

# 数据库连接（开发用 SQLite；生产用 PostgreSQL，真实值禁止提交）
DATABASE_URL=sqlite:///./data/demo/city_story.db

# Session 签名密钥（禁止提交真实值）
SESSION_SECRET=change-me-in-production

# 管理端认证密钥（禁止提交真实值）
ADMIN_JWT_SECRET=change-me-in-production

# LLM 提供方：deepseek / qwen / ollama / mock（本地开发默认 mock，无需密钥）
LLM_PROVIDER=mock

# 模型 API 密钥（禁止提交真实值）
LLM_API_KEY=

# 模型接口地址（示例值）
LLM_BASE_URL=https://api.deepseek.com/v1

# 本地向量库目录
CHROMA_PATH=./data/processed/chroma

# 允许访问的前端域名（逗号分隔）
CORS_ORIGINS=http://localhost:5173
